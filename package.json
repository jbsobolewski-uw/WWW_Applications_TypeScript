{
  "name": "scripting",
  "private": true,
  "version": "0.0.0",
  "type": "module",

  "scripts": {
    "check": "tsc --noEmit",
    "build": "npm run check && esbuild src/main.ts --bundle --outfile=dist/main.js --sourcemap",
    "dev": "esbuild src/main.ts --bundle --outfile=dist/main.js --sourcemap --watch"
  },

  "devDependencies": {
    "prettier": "^3.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}